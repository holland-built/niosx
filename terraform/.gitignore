# Terraform state + local secrets — NEVER commit
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Real secret values (the .example templates ARE committed)
secrets.auto.tfvars
*.local.tfvars

# CLI overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Per-user host registry written by wire-services.sh — contains YOUR pool ids
niosx_hosts.json
