#!/usr/bin/env bash
# Stub CSP. NEVER logs -H values: they carry the API key.
#   STUB_HTTP=401         make the applications call fail
#   STUB_APPS_FAIL=1      make it unreachable (curl-level failure)
#   STUB_NAME_TAKEN=1     the tenant already has a host with that name
#   STUB_HOST_REGISTERED=1  detail_hosts returns a registered host
#
# Shapes copied from the live API on 2026-09-02: a query that matches nothing
# answers with a bare {} — no "results" key at all. Do not "tidy" that into
# {"results": []}; parsers that only handle the tidy version break in the field.
url=""; only_code=0; want_code=0
for a in "$@"; do
  case "$a" in
    https://*) url=$a ;;
    /dev/null) only_code=1 ;;
    *%{http_code}*) want_code=1 ;;
  esac
done
code=${STUB_HTTP:-200}
body='{"results":{"applications":["dfp","dns","dhcp","cdc","anycast","orpheus","msad","authn","ntp","discovery","dgw"]}}'
HOSTID=jbeuiwrsmjsteobvhe3geolegjqtoobtmrsdqntemvsdqmzumu2tmytbgq3wizjweaqcaiba
# which detail_hosts question is being asked matters: the name check filters on
# display_name, the host lookup filters on mac_address, and list asks for all.
filter=""
for a in "$@"; do case "$a" in _filter=*) filter=$a ;; esac; done
answer=0
case "$url:$filter" in
  *detail_hosts*display_name*) [ "${STUB_NAME_TAKEN:-0}" = 1 ] && answer=1 ;;
  *detail_hosts*mac_address*)  [ "${STUB_HOST_REGISTERED:-0}" = 1 ] && answer=1 ;;
  *detail_hosts*)              [ "${STUB_HOST_REGISTERED:-0}" = 1 ] && answer=1 ;;
esac
case "$url" in
  *detail_hosts*)
    if [ "$answer" = 1 ]; then
      body='{"results":[{"id":"'$HOSTID'","display_name":"tester-250","ip_address":"10.0.0.9","composite_status":"online","mac_address":"aa:bb:cc:dd:ee:ff","pool":{"pool_id":"p1"},"configs":[{"service_type":"platform"},{"service_type":"appmgmt"}]}]}'
    else
      body='{}'                      # nothing matched — exactly what CSP sends
    fi ;;
  *"/services"*)
    if [ "${STUB_HOST_REGISTERED:-0}" = 1 ]; then
      body='{"results":[{"name":"tester-250-dns","service_type":"dns","configs":[{"host_id":"infra/host/'$HOSTID'"}]},{"name":"tester-250-dhcp","service_type":"dhcp","configs":[{"host_id":"infra/host/'$HOSTID'"}]}]}'
    else
      body='{}'
    fi ;;
esac
[ "${STUB_APPS_FAIL:-0}" = 1 ] && exit 7
if [ "$only_code" = 1 ]; then printf '%s' "$code"; exit 0; fi
if [ "$want_code" = 1 ]; then printf '%s\n%s' "$body" "$code"; exit 0; fi
printf '%s' "$body"
